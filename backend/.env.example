# Copy to backend/.env and fill in. Never commit .env.
# Gemini API key from https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
# Optional: which Gemini model writes the paper.
GEMINI_MODEL=gemini-flash-latest
# How many extra editions 'Print next edition' may print per day (after the morning one).
# Keeps the paper finite. Raise it while rehearsing a demo.
MAX_EXTRA_EDITIONS_PER_DAY=2

# --- Accounts (Supabase). Leave empty for local mode: one reader, no sign-in. ---
# Project Settings -> API (or Data API) in your Supabase project.
SUPABASE_URL=
# Publishable (anon) key: lets the server ask Supabase Auth who a token belongs to.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key: SERVER ONLY. Reads/writes each reader's row in vale_readers.
# Never put this in the frontend or in git.
SUPABASE_SECRET_KEY=

# --- Papers by email (Brevo). Leave empty to switch email off. ---
# Brevo -> SMTP & API -> API keys -> Generate a new API key
BREVO_API_KEY=
# A sender address you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Vale
# Where readers open Vale (used in email links). Change to the live address once online.
PUBLIC_APP_URL=http://localhost:5173
# Morning paper: hour (0-23) and timezone. Set DAILY_EMAIL_ENABLED=false to stop it.
DAILY_EMAIL_HOUR=7
DAILY_EMAIL_TIMEZONE=Asia/Karachi
DAILY_EMAIL_ENABLED=true
# Secrets for signed email links and the outside scheduler (any long random text).
LINK_SECRET=
CRON_SECRET=
