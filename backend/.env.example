# Copy to backend/.env and fill in. Never commit .env.
# Gemini API key from https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
# Optional: which Gemini model writes the paper.
GEMINI_MODEL=gemini-flash-latest
# How many extra editions 'Print next edition' may print per day (after the morning one).
# Keeps the paper finite. Raise it while rehearsing a demo.
MAX_EXTRA_EDITIONS_PER_DAY=2

# --- Accounts (Supabase). Leave empty for local mode: one reader, no sign-in. ---
# Project Settings -> API (or Data API) in your Supabase project.
SUPABASE_URL=
# Publishable (anon) key: lets the server ask Supabase Auth who a token belongs to.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service_role) key: SERVER ONLY. Reads/writes each reader's row in vale_readers.
# Never put this in the frontend or in git.
SUPABASE_SECRET_KEY=
