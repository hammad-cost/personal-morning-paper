# Copy to backend/.env and fill in. Never commit .env.
# Gemini API key from https://aistudio.google.com (Get API key).
GEMINI_API_KEY=
# Optional: which Gemini model writes the paper.
GEMINI_MODEL=gemini-flash-latest
# How many extra editions 'Print next edition' may print per day (after the morning one).
# Keeps the paper finite. Raise it while rehearsing a demo.
MAX_EXTRA_EDITIONS_PER_DAY=2
