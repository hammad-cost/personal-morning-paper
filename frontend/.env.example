# Copy to frontend/.env and fill in. Never commit .env.
# Copilot Cloud public API key from https://cloud.copilotkit.ai (Option A in BLUEPRINT.md).
# It is a public, browser-side key; the Editor chat is disabled without it.
VITE_COPILOTKIT_PUBLIC_API_KEY=

# Accounts (Supabase). Leave empty for local mode (no sign-in).
# Same project URL as the backend, and the PUBLISHABLE (anon) key only — never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to true after enabling Google in Supabase -> Authentication -> Providers.
VITE_AUTH_GOOGLE=false

# Online only: the backend's address (your Render URL, no trailing slash).
# Leave empty locally: Vite forwards /api to http://localhost:8000.
VITE_API_BASE=
